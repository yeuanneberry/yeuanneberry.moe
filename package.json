{
  "name": "yeuanneberry-portfolio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev --host 127.0.0.1",
    "build": "pnpm --filter web build",
    "check-types": "pnpm --filter web check-types",
    "dev:web": "pnpm --filter web dev",
    "preview": "pnpm --filter web preview --host 127.0.0.1",
    "test": "playwright test",
    "check-reader": "python3 -B scripts/sync-reader.py --verify",
    "check-ascii": "node scripts/generate-ascii-portrait.mjs --check",
    "check": "pnpm check-reader && pnpm check-ascii && pnpm check-types && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.5.0",
    "@yeuanneberry/config": "workspace:*",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.11.2"
}
