---
import Layout from "../layouts/Layout.astro";
import AsciiPortrait from "../components/AsciiPortrait.astro";
import Icon from "../components/Icon.astro";
import NamePronunciation from "../components/NamePronunciation.astro";
import { profile } from "../data/profile";
import "../styles/portfolio.css";
---

<Layout>
  <main id="main-content" class="shell about-page" tabindex="-1">
    <div class="about-intro"><div><h1>About me</h1><p class="portfolio-lede">I'm Yeuanne Berry.</p><NamePronunciation /><p>I'm a Computer Science dropout, now working full-time as a Head IT Administrator.</p></div><AsciiPortrait /></div>
    <div class="about-body">
      <section><h2>Work</h2><p>I build websites and applications through Yappers. The project pages list my contribution to each one.</p><p>I also created SoftlySang as a birthday gift for my mother, including its design and implementation.</p><a class="subtle-link" href="/work/">View projects <Icon name="arrow-right" /></a></section>
      <section><h2>Berry</h2><p>I use Arch Linux. Berry contains the desktop configuration I share, with setup and customization guides.</p><a class="subtle-link" href="/docs/">Read the docs <Icon name="arrow-right" /></a></section>
      <section class="about-contact"><h2>Links</h2><div class="about-links"><a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a><a href={profile.studio} target="_blank" rel="noopener noreferrer">Yappers <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a></div></section>
    </div>
  </main>
</Layout>
