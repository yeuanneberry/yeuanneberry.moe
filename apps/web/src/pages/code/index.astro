---
import Layout from "../../layouts/Layout.astro";
import { repositories } from "../../data/repositories";
import { profile } from "../../data/profile";
import "../../styles/portfolio.css";
---

<Layout title="Code · Yeuanne Berry" description="Public repositories, original projects, and credited forks.">
  <main id="main-content" class="shell code-page" tabindex="-1">
    <div class="code-intro"><p class="eyebrow">Out in the open</p><h1>Code to explore.</h1><p>Public repositories from my GitHub account. Forks keep their upstream identity; the license shown is the repository's declared license.</p><a class="subtle-link" href={profile.github}>View my GitHub profile ↗</a></div>
    <div class="repository-grid">{repositories.map((repo) => <article class="repository-card"><div class="repository-meta"><span>{repo.fork ? "Fork" : "Original project"}</span><span>{repo.license ?? "License not specified"}</span></div><h2><a href={repo.url}>{repo.name} ↗</a></h2><p>{repo.description}</p><a class="subtle-link" href={repo.url}>Explore repository →</a></article>)}</div>
    <section class="code-berry"><p class="eyebrow">The everyday setup</p><h2>Make Berry your own.</h2><p>A collection of reusable desktop configuration, with guides for bringing your own preferences.</p><a class="button" href="/docs/">Read the guides <span aria-hidden="true">→</span></a></section>
  </main>
</Layout>
