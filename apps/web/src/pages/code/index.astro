---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { repositories } from "../../data/repositories";
import { profile } from "../../data/profile";
import "../../styles/portfolio.css";
---

<Layout>
  <main id="main-content" class="shell code-page" tabindex="-1">
    <div class="code-intro"><h1>Code</h1><p>Selected public repositories. Forks are labelled below.</p><a class="subtle-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub profile <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a></div>
    <div class="repository-grid">{repositories.map((repo) => <article class="repository-card"><div class="repository-meta"><span>{repo.fork ? "Fork" : "Original project"}</span><span>{repo.license ?? "License not specified"}</span></div><h2><a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.name} <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a></h2><p>{repo.description}</p><a class="subtle-link" href={repo.url} target="_blank" rel="noopener noreferrer">View repository <Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a></article>)}</div>
    <section class="code-berry"><h2>Berry docs</h2><p>Setup and customization guides for the desktop configuration.</p><a class="button" href="/docs/">Read the docs <Icon name="arrow-right" /></a></section>
  </main>
</Layout>
