---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { projects, type WorkProject } from "../../data/work";
import "../../styles/work.css";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: WorkProject; }
const { project } = Astro.props;
const index = projects.findIndex((entry) => entry.slug === project.slug);
const next = projects[(index + 1) % projects.length]!;
---

<Layout title={`${project.title} · Work · Yeuanne Berry`} description={`${project.description} ${project.role}, delivered through Yappers.`}>
  <main id="main-content" class="work-page work-detail shell" tabindex="-1">
    <nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/work/">Work</a><span aria-hidden="true">/</span><span aria-current="page">{project.title}</span></nav>
    <header class="case-header">
      <div>
        <p class="eyebrow">{project.kind}</p>
        <h1>{project.title}<span class="olive">.</span></h1>
        <p class="case-lede">{project.description}</p>
      </div>
      <dl class="case-facts">
        <div><dt>My role</dt><dd>{project.role}</dd></div>
        <div><dt>With</dt><dd>Yappers</dd></div>
        <div><dt>Project</dt><dd>{project.status}</dd></div>
      </dl>
    </header>
    <figure class="case-preview">
      <Image src={project.preview} alt={project.previewAlt} widths={[640, 960, 1440]} sizes="(max-width: 850px) 100vw, 88rem" format="webp" loading="eager" />
      <figcaption>Public homepage <span aria-hidden="true">/</span> <time datetime={project.reviewedAt}>26 October 2026</time></figcaption>
    </figure>
    <div class="case-body">
      <nav class="case-sections" aria-label="Project sections">
        <a href="#the-project">01 / The project</a>
        <a href="#my-contribution">02 / My contribution</a>
        <a href="#delivery">03 / What I delivered</a>
        <a class="case-visit" href={project.url}>Visit {project.title} <span aria-hidden="true">↗</span></a>
      </nav>
      <div class="case-copy">
        <section aria-labelledby="the-project"><p class="eyebrow">01 / Context</p><h2 id="the-project">The project</h2><p>{project.goal}</p></section>
        <section aria-labelledby="my-contribution"><p class="eyebrow">02 / My part</p><h2 id="my-contribution">My contribution</h2><p>{project.contribution}</p><p class="case-credit">{project.designCredit}</p></section>
        <section aria-labelledby="delivery"><p class="eyebrow">03 / Delivery</p><h2 id="delivery">What I delivered</h2><ul>{project.delivery.map((item) => <li>{item}</li>)}</ul></section>
        <a class="button" href={project.url}>Visit {project.title}<span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <nav class="case-pagination" aria-label="More projects"><a href="/work/">← All work</a><a href={`/work/${next.slug}/`}><span>Next project</span>{next.title} →</a></nav>
  </main>
</Layout>
