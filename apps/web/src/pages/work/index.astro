---
import Layout from "../../layouts/Layout.astro";
import WorkCard from "../../components/WorkCard.astro";
import { projects } from "../../data/work";
import "../../styles/work.css";
---

<Layout>
  <main id="main-content" class="work-page shell" tabindex="-1">
    <header class="work-intro">
      <p class="eyebrow">Selected work / 01—05</p>
      <h1>Things I’ve helped bring to the web<span class="olive">.</span></h1>
      <p>Applications, company websites, and something a little more personal. These projects were delivered through Yappers; each story describes my part.</p>
    </header>
    <section aria-label="Selected projects" class="work-grid">
      {projects.map((project) => <WorkCard project={project} />)}
    </section>
    <aside class="work-afterword">
      <p class="eyebrow">The quieter side</p>
      <h2>Notes from my own setup</h2>
      <p>Berry is where I keep the desktop and development workflow in order.</p>
      <a class="subtle-link" href="/docs/">Read the Berry documentation →</a>
    </aside>
  </main>
</Layout>
