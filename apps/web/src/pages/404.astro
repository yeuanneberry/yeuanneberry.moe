---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout noindex>
  <main id="main-content" class="shell missing-page" tabindex="-1">
    <h1>Page not found</h1>
    <p>The address may have changed.</p>
    <a class="subtle-link" href="/">Home <Icon name="arrow-right" /></a>
  </main>
</Layout>

<style>
  .missing-page { padding-block: 5rem; min-height: 65vh; }
  p { color: var(--muted); margin-bottom: 2rem; }
</style>
