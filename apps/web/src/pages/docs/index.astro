---
import ManualLayout from "../../layouts/ManualLayout.astro";
import { getChapters } from "../../lib/manual";

const chapters = (await getChapters()).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  group: entry.data.group,
  order: entry.data.order,
}));
---

<ManualLayout title="Documentation" description="Berry's desktop and development guides." current="index">
  <div class="index-intro">
    <p class="eyebrow">The field manual / {String(chapters.length).padStart(2, "0")} chapters</p>
    <h1>Documentation</h1>
    <p>Adopt the parts of Berry that fit your setup. Start with one application, keep your own preferences, and follow the guides at your own pace.</p>
  </div>
  <section aria-label="Chapters">
    <ol class="chapter-list">
      {chapters.map((chapter) => <li>
        <a class="chapter-result" href={`/docs/${chapter.id}/`}>
          <span class="result-meta">{String(chapter.order).padStart(2, "0")} / {chapter.group}</span>
          <h2>{chapter.title}</h2>
          <p>{chapter.description}</p>
          <span class="read-label">Read chapter</span>
        </a>
      </li>)}
    </ol>
  </section>
  <p class="reader-note">A collection of application presets and a minimal Hyprland/Waybar starting point. Each guide explains its scope and what to check before adopting it.</p>
</ManualLayout>
