---
import ManualLayout from "../../layouts/ManualLayout.astro";
import DocumentationSearch from "../../components/DocumentationSearch";
import { getChapters, searchText } from "../../lib/manual";

const chapters = (await getChapters()).map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  group: entry.data.group,
  order: entry.data.order,
  text: searchText(entry.body ?? ""),
}));
---

<ManualLayout title="Documentation" description="Read and search Berry's desktop and development guides." current="index">
  <div class="index-intro">
    <p class="eyebrow">The field manual / {String(chapters.length).padStart(2, "0")} chapters</p>
    <h1>Documentation</h1>
    <p>Adopt the parts of Berry that fit your setup. Start with one application, keep your own preferences, and follow the guides at your own pace.</p>
  </div>
  <noscript><p class="reader-note">All chapters are available below. Enable JavaScript to search their contents.</p></noscript>
  <DocumentationSearch chapters={chapters} client:load />
  <p class="reader-note">A collection of application presets and a minimal Hyprland/Waybar starting point. Each guide explains its scope and what to check before adopting it.</p>
</ManualLayout>
