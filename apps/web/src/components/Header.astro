---
import { Image } from "astro:assets";
import portrait from "../assets/profile.png";
import Icon from "./Icon.astro";
import navigationScript from "../scripts/navigation.js?raw";
const path = Astro.url.pathname;
const links = [
  ["Home", "/"], ["Work", "/work/"], ["Code", "/code/"],
  ["Berry docs", "/docs/"], ["About", "/about/"],
];
const current = (href: string) => path === href ? "page" : href !== "/" && path.startsWith(href) ? "true" : undefined;
---

<header class="site-header" data-site-navigation>
  <div class="header-inner shell">
    <a class="wordmark" href="/" aria-label="Yeuanne Berry home">
      <Image src={portrait} width={32} height={32} widths={[32, 64, 96]} sizes="32px" format="webp" quality={90} alt="" class="header-avatar" />
      <span>yeuanne<span class="olive">berry</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {links.map(([label, href]) => <a href={href} aria-current={current(href!)}>{label}</a>)}
    </nav>
    <button class="mobile-menu-toggle menu-control" id="open-navigation" type="button" aria-label="Open menu" aria-controls="mobile-navigation" aria-expanded="false" aria-haspopup="dialog">
      <Icon name="menu" size={20} />
    </button>
  </div>
  <dialog class="mobile-menu" id="mobile-navigation" aria-label="Navigation">
    <div class="mobile-menu-inner shell">
      <div class="mobile-menu-top">
        <div class="wordmark" aria-hidden="true">
          <Image src={portrait} width={32} height={32} widths={[32, 64, 96]} sizes="32px" format="webp" quality={90} alt="" class="menu-avatar" />
          <span>yeuanne<span class="olive">berry</span></span>
        </div>
        <button id="close-navigation" class="mobile-menu-close menu-control" type="button" aria-label="Close menu" autofocus>
          <Icon name="close" size={20} />
        </button>
      </div>
      <nav class="mobile-nav" aria-label="Primary">
        {links.map(([label, href]) => <a href={href} aria-current={current(href!)}>{label}</a>)}
      </nav>
    </div>
  </dialog>
</header>
<script is:inline set:html={navigationScript} />
<noscript>
  <style is:inline>
    @media (max-width: 850px) {
      .site-header .mobile-menu-toggle { display: none; }
      .site-header .header-inner { flex-wrap: wrap; padding-block: .8rem; }
      .site-header .desktop-nav { display: flex; width: 100%; justify-content: space-between; gap: .5rem; }
    }
  </style>
</noscript>
