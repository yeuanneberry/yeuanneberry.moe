---
import { Image } from "astro:assets";
import type { WorkProject } from "../data/work";
import "../styles/work.css";

interface Props {
  project: WorkProject;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel = "h2" } = Astro.props;
const Heading = headingLevel;
---

<article class="work-card">
  <a class="work-preview-link" href={`/work/${project.slug}/`} aria-label={`Read about ${project.title}`}>
    <Image src={project.preview} alt={project.previewAlt} widths={[480, 800, 1200]} sizes="(max-width: 700px) 100vw, 50vw" format="webp" loading="lazy" />
    <span class="work-preview-label" aria-hidden="true">Read project <span>↗</span></span>
  </a>
  <div class="work-card-copy">
    <p class="work-kind">{project.kind}</p>
    <Heading><a href={`/work/${project.slug}/`}>{project.title}</a></Heading>
    <p class="work-description">{project.description}</p>
    <p class="work-role">{project.role}</p>
    <p class="work-relationship">{project.relationship}</p>
  </div>
</article>
