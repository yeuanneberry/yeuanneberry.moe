---
import { Menu, X, ArrowRight, ArrowLeft, ExternalLink, ChevronDown, Plus, ArrowUp } from "@lucide/astro";

const icons = {
  menu: Menu, close: X, "arrow-right": ArrowRight, "arrow-left": ArrowLeft,
  external: ExternalLink, "chevron-down": ChevronDown, plus: Plus, "arrow-up": ArrowUp,
};

interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
const Symbol = icons[name];
---

<Symbol size={size} stroke-width={1.75} class:list={["ui-icon", className]} aria-hidden="true" focusable="false" />
