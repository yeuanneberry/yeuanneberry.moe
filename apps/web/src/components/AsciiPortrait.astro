---
import desktop from "../assets/ascii/portrait-desktop.txt?raw";
import mobile from "../assets/ascii/portrait-mobile.txt?raw";
import "../styles/ascii-portrait.css";
---

<figure class="ascii-portrait" role="img" aria-label="ASCII rendering of Yeuanne Berry's profile artwork">
  <pre class="ascii-portrait-desktop" aria-hidden="true">{desktop.slice(0, -1)}</pre>
  <pre class="ascii-portrait-mobile" aria-hidden="true">{mobile.slice(0, -1)}</pre>
</figure>
