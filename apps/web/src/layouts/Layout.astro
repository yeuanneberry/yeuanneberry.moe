---
import "../styles/global.css";
import Header from "../components/Header.astro";
import { getImage } from "astro:assets";
import portrait from "../assets/profile.png";
import { profile } from "../data/profile";

const title = profile.name;
const favicon = await getImage({ src: portrait, width: 32, height: 32, format: "png" });
const touchIcon = await getImage({ src: portrait, width: 180, height: 180, format: "png" });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={profile.name} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={profile.name} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <footer class="site-footer shell">
      <p>Yeuanne Berry</p>
      <nav aria-label="Elsewhere">
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗<span class="sr-only"> (opens in a new tab)</span></a>
        <a href={profile.studio} target="_blank" rel="noopener noreferrer">Yappers ↗<span class="sr-only"> (opens in a new tab)</span></a>
        <a href="/docs/">Berry docs →</a>
      </nav>
    </footer>
  </body>
</html>
